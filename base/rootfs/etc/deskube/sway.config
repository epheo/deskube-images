# One virtual output, drawn on the GPU, never shown on a real screen.
# Nothing on it: no bar, no terminal, no bindings. An image that puts
# one app here leaves a user nothing to reach but that app, and the
# stream is black until the app draws. The desktop image brings its own.
output HEADLESS-1 resolution 1920x1080@60Hz position 0 0 bg #000000 solid_color
default_border none
# Images that carry Xwayland do so for gamescope, which starts its own.
xwayland disable
