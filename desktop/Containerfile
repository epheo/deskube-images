# A desktop on the base image: sway with the keys most people expect
# from it, a terminal, a launcher, Chromium. Wayland only: Fedora's
# Chromium runs on Wayland by itself when WAYLAND_DISPLAY is set, and
# its sandbox needs user namespaces, which the launcher must allow as
# for Steam (podman does; the operator's nestedSandboxes on a cluster).
ARG BASE=ghcr.io/epheo/deskube-base:main
FROM ${BASE}
USER 0
# The launcher lists desktop entries; a second Sunshine or foot's server
# mode are not for the user to start. Chromium: no keyring in the pod,
# no first run page, and Wayland whatever the session variables say.
RUN dnf -y install foot fuzzel chromium && dnf clean all \
    && rm -f /usr/share/applications/dev.lizardbyte.app.Sunshine*.desktop \
         /usr/share/applications/foot-server.desktop /usr/share/applications/footclient.desktop \
    && printf '%s\n' 'CHROMIUM_FLAGS+=" --ozone-platform=wayland --password-store=basic --no-first-run"' \
         >> /etc/chromium/chromium.conf
COPY rootfs/ /
USER 1000
