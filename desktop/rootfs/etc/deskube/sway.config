# One virtual output, rendered on the GPU, never shown on a real screen.
output HEADLESS-1 resolution 1920x1080@60Hz position 0 0 bg #1e2030 solid_color
default_border pixel 2
bar {
    position top
    status_command while date +'%H:%M:%S'; do sleep 1; done
}
exec foot
include /etc/deskube/sway.d/*
