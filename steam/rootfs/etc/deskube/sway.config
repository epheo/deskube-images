# Steam in gamescope is this desktop's only window. No bar, no terminal,
# no bindings: the keyboard reaches nothing but Steam, and the stream is
# black until gamescope draws.
output HEADLESS-1 resolution 1920x1080@60Hz position 0 0 bg #000000 solid_color
default_border none
# This image carries Xwayland for gamescope, which starts its own.
xwayland disable
